# Copy to .env and source it, or export the variables directly.

# Matches the Keycloak realm in docker-compose.yml (docker compose up -d).
OIDCCLI_ISSUER=http://localhost:8081/realms/demo
OIDCCLI_CLIENT_ID=oidc-cli
OIDCCLI_API_URL=http://localhost:8080/api/hello

# Against a real provider, use its issuer and your own client instead:
#OIDCCLI_ISSUER=https://id.example.com/realms/demo
#OIDCCLI_CLIENT_ID=oidc-cli

# Only if the provider requires a secret; a CLI is normally a public client.
#OIDCCLI_CLIENT_SECRET=
OIDCCLI_SCOPES="openid profile email offline_access"
# Needed by providers that only issue a JWT access token for a named audience.
# The bundled Keycloak realm puts "demo-api" into the audience by default, so
# only `oidc-cli serve` needs it: oidc-cli serve --audience demo-api
#OIDCCLI_AUDIENCE=https://api.example.com
# Fixed loopback port if the provider requires an exact redirect URI.
#OIDCCLI_REDIRECT_PORT=8400
